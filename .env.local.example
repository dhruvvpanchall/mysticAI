# Copy to .env.local and fill in. Restart `npm run dev` after editing.
#
# ─────────────────────────────────────────────────────────────────────────
#  LLM provider (chat + translation)
# ─────────────────────────────────────────────────────────────────────────
# Free Gemini key: https://aistudio.google.com/apikey
# Without a key, /api/chat still works but returns the deterministic grounded
# fallback (verified verse, no LLM explanation).
GEMINI_API_KEY=AIza...
# Optional — swap to any OpenAI-compatible provider with no code change:
#   Groq:       LLM_BASE_URL=https://api.groq.com/openai/v1            LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1              LLM_MODEL=deepseek/deepseek-chat-v3:free
# (the route reads the key from GEMINI_API_KEY regardless of provider)
# LLM_BASE_URL=
# LLM_MODEL=

# ─────────────────────────────────────────────────────────────────────────
#  Firebase (auth + Firestore persistence)
# ─────────────────────────────────────────────────────────────────────────
# Get these from Firebase Console → Project Settings → General → Your apps.
# All six are required. NEXT_PUBLIC_* means they ship in the browser bundle —
# that's expected and safe for Firebase web config (it's not a secret; security
# is enforced by Firestore rules, not by hiding the apiKey).
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
